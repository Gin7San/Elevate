DATABASE_URL="postgresql://interviewsense:interviewsense_dev@localhost:5432/interviewsense?schema=public"
PORT=4000
CLIENT_URL="http://localhost:5173"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
OPENAI_API_KEY=""

# Password-reset email delivery. When SMTP_URL is empty, the reset token is
# returned in the API response as a development fallback.
SMTP_URL=""
SMTP_FROM="InterviewSense <no-reply@interviewsense.local>"

# Cookie behaviour: "true" forces Secure cookies, "false" allows http://
# development; default is Secure when NODE_ENV=production.
COOKIE_SECURE=""

# Lifetime (seconds) of signed media URLs for private recordings (60-3600).
MEDIA_URL_TTL_SECONDS=900
