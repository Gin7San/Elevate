DATABASE_URL="postgresql://interviewsense:interviewsense_dev@localhost:5432/interviewsense?schema=public"
PORT=4000
CLIENT_URL="http://localhost:5173"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
OPENAI_API_KEY=""

# Password-reset email delivery. When SMTP_URL is empty, the reset token is
# returned in the API response as a development fallback.
SMTP_URL=""
SMTP_FROM="InterviewSense <no-reply@interviewsense.local>"

# Cookie behaviour: "true" forces Secure cookies, "false" allows http://
# development; default is Secure when NODE_ENV=production.
COOKIE_SECURE=""

# Lifetime (seconds) of signed media URLs for private recordings (60-3600).
MEDIA_URL_TTL_SECONDS=900

# --- Transcription -----------------------------------------------------------
# "openai" (default) or "none" to disable the feature entirely.
TRANSCRIPTION_PROVIDER="openai"
# Any OpenAI-compatible /audio/transcriptions endpoint: OpenAI itself, Groq
# (https://api.groq.com/openai/v1 with OPENAI_TRANSCRIBE_MODEL=whisper-large-v3-turbo),
# Deepgram, or a self-hosted whisper-server.
OPENAI_BASE_URL=""
# TRANSCRIPTION_BASE_URL overrides OPENAI_BASE_URL for transcription only.
TRANSCRIPTION_BASE_URL=""
OPENAI_TRANSCRIBE_MODEL="whisper-1"
# Per-call timeout and retry budget for the upstream request.
TRANSCRIPTION_TIMEOUT_MS=60000
TRANSCRIPTION_MAX_RETRIES=2
# Seconds an identical recording is served from cache instead of being re-billed
# (0 disables caching).
TRANSCRIPTION_CACHE_TTL_SECONDS=3600
# Re-encode uploads to 16 kHz mono WAV with ffmpeg before sending them upstream.
# Falls back to the original upload when ffmpeg is unavailable.
TRANSCRIPTION_EXTRACT_AUDIO=true
FFMPEG_PATH="ffmpeg"
# Requests per user per 15 minutes: final transcriptions, and live-caption polls.
TRANSCRIPTION_RATE_LIMIT_MAX=20
TRANSCRIPTION_LIVE_RATE_LIMIT_MAX=240
