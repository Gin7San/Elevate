{
  "name": "interviewsense-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma": "prisma",
    "test": "node --import tsx --test src/services/*.test.ts src/lib/*.test.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 src/e2e/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@prisma/client": "6.7.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "openai": "^5.12.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^8.0.2",
    "prisma": "6.7.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
